UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,docx,txt
LOG_LEVEL=INFO

# Tesseract OCR Configuration (optional - leave empty to use system default)
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: /usr/bin/tesseract
TESSERACT_CMD=

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# MongoDB Configuration (optional - leave default for local MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=legaldocai_db
